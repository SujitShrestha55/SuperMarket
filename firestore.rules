rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Every real account has a matching staff profile at
    // stores/main/staff/{uid}, created by an admin (see README-FIREBASE.md).
    // Accounts without a profile have no access to store data.
    function staffDoc() {
      return get(/databases/$(database)/documents/stores/main/staff/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/main/staff/$(request.auth.uid));
    }

    function isAdmin() {
      return isStaff() && staffDoc().data.role == 'admin';
    }

    match /stores/{storeId} {

      // Staff profiles hold each account's role. Never writable from the
      // client — provisioned from the Firebase console / an admin process.
      match /staff/{uid} {
        allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow write: if false;
      }

      match /products/{productId} {
        allow read: if isStaff();
        // Only admins manage the product catalog...
        allow create, delete: if isAdmin();
        // ...but a cashier's checkout still needs to decrement stock.
        // Allow non-admin staff to update ONLY stock/updatedAt; anything
        // else (price, name, etc.) requires an admin.
        allow update: if isAdmin() ||
          (isStaff() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']));
      }

      match /sales/{saleId} {
        allow read: if isStaff();
        // A new bill can't be created pre-voided.
        allow create: if isStaff() &&
          (!('voided' in request.resource.data) || request.resource.data.voided == false);
        // Bills are never hard-deleted — only voided (an update), and only
        // by an admin, and only touching the void-related fields.
        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['voided', 'voidedBy', 'voidedAt', 'voidReason']);
        allow delete: if false;
      }
    }
  }
}
